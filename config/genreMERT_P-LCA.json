      "y_pred": 0.7,
      "y_effect": 1.0,
      "y_cf": 0.6,
      "y_cf_entropy": 2.0,
      "y_entropy": 1.5,
      "att_loss": 2.0
    }
  },
  "data_config": {
    "dataset": "gtzan",
    "slice_length": 10,
    "seconds_overlap": 1,
    "nb_classes": 10,
    "datasplit": "songs"
